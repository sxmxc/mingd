# Worker services, on dedicated or shared hosts. Use with compose.workers.prod.yml.
# Keep this configuration separate from application Supabase/Redis credentials.
# Optional explicit project name, especially when sharing a host with the app.
# COMPOSE_PROJECT_NAME=mingd-workers
IMAGE_PREFIX=ghcr.io/sxmxc/mingd
IMAGE_TAG=v0.2.3
# Independent image versions; release commands update these overrides.
WORKER_GATEWAY_URL=https://worker.mingd.example.com
BUILDER_CONCURRENCY=1
SCONS_JOBS=4
BUILDER_COMPILE_TIMEOUT_MS=7200000
# Limits apply PER CONTAINER, not per host. Budget the sum of running workers.
WORKER_CPUS=4
WORKER_MEMORY_LIMIT=8g
# Desktop release LTO gets a separate ceiling; other workers retain the limit above.
DESKTOP_WORKER_MEMORY_LIMIT=16g
DESKTOP_WORKER_TOKEN_FILE=./worker-tokens/desktop.token
WEB_WORKER_TOKEN_FILE=./worker-tokens/web.token
ANDROID_WORKER_TOKEN_FILE=./worker-tokens/android.token
MACOS_WORKER_TOKEN_FILE=./worker-tokens/macos.token
# Required when enabling the macos profile; matches the image and enrollment.
# MACOS_TOOLCHAIN_SHA256=
BUILDER_IMAGE_TAG=v0.3.0
WEB_BUILDER_IMAGE_TAG=v0.3.0
ANDROID_BUILDER_IMAGE_TAG=v0.3.0
MACOS_BUILDER_IMAGE_TAG=v0.3.1
