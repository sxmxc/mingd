# Container images (local defaults: mingd/<service>:latest).
# Use the same prefix on both hosts; production can select latest or a release.
# IMAGE_PREFIX=ghcr.io/sxmxc/mingd
# IMAGE_TAG=latest
# Publish both latest and a release identifier after building:
# npm run images:publish:all -- v0.1.0
# See docs/deployment.md for build/push and pull-only deployment.

# Web app / Supabase
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Must be reachable by browsers AND the web container. In Docker, loopback
# addresses refer to the container itself; use your self-hosted public API URL.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
# Rebuild the web image after changing any NEXT_PUBLIC_* value:
# npm run compose:web:build
# Self-hosted Auth SITE_URL/templates live in the Supabase deployment's
# configuration; see docs/self-hosted-supabase.md.
SUPABASE_SECRET_KEY=replace-me
WEB_PORT=3000

# Database migrations for a self-hosted Supabase Postgres instance. This is a
# server-only, percent-encoded Postgres connection URI; never use a
# NEXT_PUBLIC_ variable or commit a real value.
# SUPABASE_DB_URL=postgresql://postgres:replace-me@db.example.com:5432/postgres

# Queue
REDIS_URL=redis://127.0.0.1:6379
BUILDER_QUEUE_NAME=godot-builds
WEB_BUILDER_QUEUE_NAME=godot-web-builds
ANDROID_BUILDER_QUEUE_NAME=godot-android-builds
MACOS_BUILDER_QUEUE_NAME=godot-macos-builds
# Enable macOS only after supplying and validating an OSXCross + Apple SDK toolchain.
# MACOS_TOOLCHAIN_SHA256=<sha256 of toolchains/macos-toolchain.tar.xz>

# Artifact storage
ARTIFACT_BUCKET=build-artifacts
SIGNED_DOWNLOAD_TTL_SECONDS=900

# Builder
SUPABASE_URL=http://host.docker.internal:54321
BUILDER_CONCURRENCY=1
BUILDER_DRY_RUN=false
GODOT_CACHE_DIR=/cache/godot
GODOT_WORK_DIR=/work/jobs
CCACHE_DIR=/cache/ccache

# Optional: limit parallel SCons jobs. Defaults to 4; tune against CPU/RAM.
SCONS_JOBS=4

# Abort a stalled real compile after two hours.
BUILDER_COMPILE_TIMEOUT_MS=7200000
