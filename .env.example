# Container images (local defaults: mingd/<service>:latest).
# IMAGE_PREFIX=ghcr.io/sxmxc/mingd
# IMAGE_TAG=latest
# Targeted build/push/publish records its service tag here automatically.
# npm run publish -- web -- v0.2.4
# npm run publish -- all   # preserves every service's configured tag
# WEB_IMAGE_TAG=v0.2.4
# WORKER_GATEWAY_IMAGE_TAG=v0.2.3
# MAINTENANCE_IMAGE_TAG=v0.2.3
# BUILDER_IMAGE_TAG=v0.2.3
# WEB_BUILDER_IMAGE_TAG=v0.2.3
# ANDROID_BUILDER_IMAGE_TAG=v0.2.3
# MACOS_BUILDER_IMAGE_TAG=v0.2.3
# See docs/operators/deployment.md for publishing and targeted production updates.

# Web app / Supabase
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Must be reachable by browsers AND the web container. In Docker, loopback
# addresses refer to the container itself; use your self-hosted public API URL.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
# These existing variable names are read on the server at runtime.
# Recreate web after changing them; rebuilding the image is unnecessary:
# docker compose up -d --no-deps --no-build --force-recreate web
# Self-hosted Auth SITE_URL/templates live in the Supabase deployment's
# configuration; see docs/operators/self-hosted-supabase.md.
SUPABASE_SECRET_KEY=replace-me
WEB_PORT=3000

# Worker gateway (opt-in gateway profile for the source checkout).
# Publishes on host port 3001, like the web service; no host IP setting needed.
# WORKER_GATEWAY_PORT=3001
# Web server reads live gateway versions for the Administration footer.
# Set in apps/web/.env.local for npm development; Compose defaults to its service DNS.
# WORKER_GATEWAY_INTERNAL_URL=http://127.0.0.1:3001
# WORKER_GATEWAY_LOG_LEVEL=info
# Enable worker control and execution after migrations and stopping direct builders.
# WORKER_GATEWAY_WORKERS_ENABLED=false
# WORKER_GATEWAY_EXECUTION_ENABLED=false
# WORKER_GATEWAY_QUEUE_CONCURRENCY=16
# WORKER_GATEWAY_MAX_UPLOADS=2
# WORKER_GATEWAY_MAX_JOB_MS=43200000
# WORKER_GATEWAY_WORK_DIR=/tmp/mingd-gateway
# Direct npm development defaults to loopback; Docker overrides this to 0.0.0.0.
# WORKER_GATEWAY_HOST=127.0.0.1

# Database migrations for a self-hosted Supabase Postgres instance. This is a
# server-only, percent-encoded Postgres connection URI; never use a
# NEXT_PUBLIC_ variable or commit a real value.
# SUPABASE_DB_URL=postgresql://postgres:replace-me@db.example.com:5432/postgres

# Queue
REDIS_URL=redis://127.0.0.1:6379
BUILDER_QUEUE_NAME=godot-builds
WEB_BUILDER_QUEUE_NAME=godot-web-builds
ANDROID_BUILDER_QUEUE_NAME=godot-android-builds
MACOS_BUILDER_QUEUE_NAME=godot-macos-builds
# Enable macOS only after supplying and validating an OSXCross + Apple SDK toolchain.
# MACOS_TOOLCHAIN_SHA256=<sha256 of toolchains/macos-toolchain.tar.xz>

# Artifact storage
ARTIFACT_BUCKET=build-artifacts
SIGNED_DOWNLOAD_TTL_SECONDS=900

# Builder: direct mode remains available for local development.
# Dedicated production hosts use .env.workers.prod.example instead: no backend secrets.
# BUILDER_MODE=direct
# WORKER_GATEWAY_URL=https://worker.mingd.voidmoose.net
# WORKER_TOKEN_FILE=/run/secrets/worker_token
SUPABASE_URL=http://host.docker.internal:54321
BUILDER_CONCURRENCY=1
BUILDER_DRY_RUN=false
GODOT_CACHE_DIR=/cache/godot
GODOT_WORK_DIR=/work/jobs
CCACHE_DIR=/cache/ccache

# Optional: limit parallel SCons jobs. Defaults to 4; tune against CPU/RAM.
SCONS_JOBS=4

# Abort a stalled real compile after two hours.
BUILDER_COMPILE_TIMEOUT_MS=7200000
