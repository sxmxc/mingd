# Web app / Supabase
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_SECRET_KEY=replace-me

# Queue
REDIS_URL=redis://127.0.0.1:6379
BUILDER_QUEUE_NAME=godot-builds

# Artifact storage
ARTIFACT_BUCKET=build-artifacts
SIGNED_DOWNLOAD_TTL_SECONDS=900

# Builder
SUPABASE_URL=http://host.docker.internal:54321
BUILDER_CONCURRENCY=1
BUILDER_DRY_RUN=false
GODOT_CACHE_DIR=/cache/godot
GODOT_WORK_DIR=/work/jobs
CCACHE_DIR=/cache/ccache

# Optional: limit parallel SCons jobs. Defaults to 4; tune against CPU/RAM.
SCONS_JOBS=4

# Abort a stalled real compile after two hours.
BUILDER_COMPILE_TIMEOUT_MS=7200000
