{
  "name": "mingd",
  "private": true,
  "version": "0.2.2",
  "description": "Build only the Godot your game needs.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @mingd/web",
    "dev:builder": "npm run dev --workspace @mingd/builder",
    "dev:worker-gateway": "dotenv -- npm run dev --workspace @mingd/worker-gateway",
    "workers": "dotenv -- npm run operator --workspace @mingd/worker-gateway --",
    "dev:web-builder": "BUILDER_TARGET=web BUILDER_QUEUE_NAME=godot-web-builds dotenv -- npm run dev --workspace @mingd/builder",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test scripts/test/*.test.mjs",
    "db:migration:new": "npx supabase migration new",
    "db:local:status": "npx supabase migration list --local",
    "db:local:reset": "npx supabase db reset --local",
    "db:status": "dotenv -- sh -c 'npx supabase migration list --db-url \"$SUPABASE_DB_URL\"'",
    "db:migrate:check": "dotenv -- sh -c 'npx supabase db push --dry-run --skip-vault --db-url \"$SUPABASE_DB_URL\"'",
    "db:migrate": "dotenv -- sh -c 'npx supabase db push --skip-vault --db-url \"$SUPABASE_DB_URL\"'",
    "docs:dev": "npm run dev --workspace @mingd/docs --",
    "docs:build": "npm run build --workspace @mingd/docs --",
    "docs:preview": "npm run preview --workspace @mingd/docs --",
    "compose": "docker compose",
    "publish": "node scripts/publish-images.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.0.0",
    "supabase": "^2.119.0"
  }
}
