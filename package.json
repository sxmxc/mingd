{
  "name": "mingd",
  "private": true,
  "version": "0.1.1",
  "description": "Build only the Godot your game needs.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @mingd/web",
    "dev:builder": "npm run dev --workspace @mingd/builder",
    "dev:worker-gateway": "dotenv -- npm run dev --workspace @mingd/worker-gateway",
    "dev:web-builder": "npm run dev --workspace @mingd/web-builder",
    "build": "npm run build --workspace @mingd/web && npm run build --workspace @mingd/builder",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "compose:build": "docker compose up -d --build",
    "compose:up": "docker compose up -d",
    "compose:up:builders": "docker compose --profile builder up -d",
    "compose:down": "docker compose down",
    "compose:down:all": "docker compose --profile '*' down",
    "compose:ps": "docker compose ps",
    "compose:logs": "docker compose logs -f",
    "images:build": "docker compose build web worker-gateway maintenance builder web-builder android-builder",
    "images:build:all": "docker compose build web maintenance builder web-builder android-builder macos-builder worker-gateway",
    "images:push": "docker compose push web worker-gateway maintenance builder web-builder android-builder",
    "images:push:all": "docker compose push web maintenance builder web-builder android-builder macos-builder worker-gateway",
    "images:publish": "node scripts/publish-images.mjs",
    "images:publish:all": "node scripts/publish-images.mjs --all",
    "images:pull": "docker compose --profile builder pull",
    "images:pull:all": "docker compose --profile '*' pull",
    "images:up": "docker compose --profile builder up -d --no-build --pull never",
    "images:up:all": "docker compose --profile '*' up -d --no-build --pull never",
    "compose:redis": "docker compose up -d redis",
    "compose:web": "docker compose up -d web",
    "compose:web:build": "docker compose up -d --build web",
    "compose:web:logs": "docker compose logs -f web",
    "compose:worker-gateway:build": "docker compose up -d --build worker-gateway",
    "compose:worker-gateway:logs": "docker compose logs -f worker-gateway",
    "compose:web-builder": "docker compose up -d web-builder",
    "compose:web-builder:build": "docker compose up -d --build web-builder",
    "compose:web-builder:logs": "docker compose logs -f web-builder",
    "compose:builder": "docker compose up -d builder",
    "compose:builder:build": "docker compose up -d --build builder",
    "compose:builder:logs": "docker compose logs -f builder",
    "compose:builders": "docker compose up -d builder web-builder android-builder",
    "compose:builders:build": "docker compose up -d --build builder web-builder android-builder",
    "compose:builders:build:all": "docker compose up -d --build builder web-builder android-builder macos-builder",
    "compose:builders:logs": "docker compose logs -f builder web-builder android-builder",
    "db:migration:new": "npx supabase migration new",
    "db:local:status": "npx supabase migration list --local",
    "db:local:reset": "npx supabase db reset --local",
    "db:status": "dotenv -- sh -c 'npx supabase migration list --db-url \"$SUPABASE_DB_URL\"'",
    "db:migrate:check": "dotenv -- sh -c 'npx supabase db push --dry-run --skip-vault --db-url \"$SUPABASE_DB_URL\"'",
    "db:migrate": "dotenv -- sh -c 'npx supabase db push --skip-vault --db-url \"$SUPABASE_DB_URL\"'",
    "compose:android-builder": "docker compose up -d android-builder",
    "compose:android-builder:build": "docker compose up -d --build android-builder",
    "compose:android-builder:logs": "docker compose logs -f android-builder",
    "compose:macos-builder": "docker compose up -d macos-builder",
    "compose:macos-builder:down": "docker compose --profile macos-builder down",
    "compose:macos-builder:build": "docker compose up -d --build macos-builder",
    "compose:macos-builder:logs": "docker compose logs -f macos-builder",
    "compose:maintenance": "docker compose up -d maintenance",
    "compose:maintenance:build": "docker compose up -d --build maintenance",
    "compose:maintenance:logs": "docker compose logs -f maintenance"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.0.0",
    "supabase": "^2.119.0"
  }
}
