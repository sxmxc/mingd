# Application host only. Use with compose.web.prod.yml.
IMAGE_PREFIX=ghcr.io/sxmxc/mingd
IMAGE_TAG=v0.2.1
NEXT_PUBLIC_APP_URL=https://mingd.voidmoose.net
NEXT_PUBLIC_SUPABASE_URL=https://supabase.voidmoose.net
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_URL=https://supabase.voidmoose.net
SUPABASE_SECRET_KEY=replace-me
WEB_PORT=3000
WORKER_GATEWAY_PORT=3001
# Enable only after applying migrations and stopping the direct builders.
WORKER_GATEWAY_WORKERS_ENABLED=true
WORKER_GATEWAY_EXECUTION_ENABLED=true
WORKER_GATEWAY_LOG_LEVEL=info
WORKER_GATEWAY_QUEUE_CONCURRENCY=16
WORKER_GATEWAY_MAX_UPLOADS=2
WORKER_GATEWAY_MAX_JOB_MS=43200000
BUILDER_QUEUE_NAME=godot-builds
WEB_BUILDER_QUEUE_NAME=godot-web-builds
ANDROID_BUILDER_QUEUE_NAME=godot-android-builds
MACOS_BUILDER_QUEUE_NAME=godot-macos-builds
ARTIFACT_BUCKET=build-artifacts
SIGNED_DOWNLOAD_TTL_SECONDS=900
BUILDER_DRY_RUN=false
# Same verified digest as any enrolled macOS workers, when enabled.
# MACOS_TOOLCHAIN_SHA256=
# Operator migration commands only; never passed to remote worker containers.
# SUPABASE_DB_URL=postgresql://postgres:replace-me@db.example.com:5432/postgres
